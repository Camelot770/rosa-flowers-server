DATABASE_URL=file:/data/rosa.db
BOT_TOKEN=your_telegram_bot_token
MAX_BOT_TOKEN=your_max_bot_token
ADMIN_BOT_TOKEN=your_admin_bot_token
WEBAPP_URL=https://rosa-flowers-client.vercel.app
MAX_WEBAPP_URL=https://rosa-cvetov-max.vercel.app
ADMIN_WEBAPP_URL=https://rosa-flowers-admin.vercel.app
SITE_URL=https://rosa-web.vercel.app
JWT_SECRET=your_jwt_secret_key
# Replaces the default admin password at startup; also the password of a newly seeded admin
ADMIN_PASSWORD=your_admin_password
YUKASSA_SHOP_ID=your_shop_id
YUKASSA_SECRET_KEY=your_secret_key
YUKASSA_RETURN_URL=https://rosa-flowers-client.vercel.app/orders
PORT=4000
# /data is the persistent disk on Amvera, anything else is lost on deploy
UPLOADS_DIR=/data/uploads
